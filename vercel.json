{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      64,
      128,
      256,
      640,
      828,
      1080,
      1600,
      1920
    ],
    "localPatterns": [
      {
        "pathname": "^/.*\\.(png|PNG|jpg|jpeg)$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 2678400,
    "qualities": [
      60,
      75,
      85
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ]
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sucolor.vercel.app"
        }
      ],
      "destination": "https://sucolor.autos/:path*",
      "permanent": true
    }
  ]
}
